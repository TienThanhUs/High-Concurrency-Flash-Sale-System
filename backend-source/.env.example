# Application
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
POSTGRES_DB=flash-mart
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/flash-mart
DB_USERNAME=shop
DB_PASSWORD=shop

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (KRaft)
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=flashmart-order-group
KAFKA_ORDER_CREATED_TOPIC=flashmart.order-created

# JWT (Must be at least 32 bytes for HMAC-SHA256)
JWT_SECRET=ChangeThisToAStrong256BitProductionSecretKey123456!
JWT_EXPIRATION_MS=1800000

# Initial ADMIN account seeded on startup (leave password empty to disable seeding)
ADMIN_USERNAME=adminUser
ADMIN_EMAIL=admin@flashmart.com
ADMIN_PASSWORD=ChangeMeAdminPassword123!
